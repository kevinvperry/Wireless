{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wireless-directory-local",
  "main": "src/index.js",
  "compatibility_date": "2026-06-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wireless-directory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "wireless-station-artwork-local"
    }
  ],
  "vars": {
    "AUTH_MODE": "password"
  },
  "observability": {
    "enabled": true
  }
}
